{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crebain.local/schemas/crebain.real-nest-closed-loop-capture.v2.schema.json",
  "title": "CREBAIN real-NEST closed-loop capture v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engram_source_sha256",
    "engram_source_closure",
    "package_generation_id",
    "installed_package_proof_exact_sha256",
    "installed_package_proof",
    "plan_exact_sha256",
    "nest_config_exact_sha256",
    "receipt_lock_timeout_ms",
    "run_plan",
    "nest_config",
    "summary",
    "terminal_receipt",
    "reviewed_native_runtime",
    "nest_worker_guardian_closure",
    "receipt_store_closure",
    "receipt_store_sidecars",
    "population_topology",
    "nest_evidence_bundle",
    "neural_steps",
    "assertions",
    "authority",
    "disclosure"
  ],
  "properties": {
    "schema_version": { "const": "crebain.real-nest-closed-loop-capture.v2" },
    "engram_source_sha256": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1024,
      "propertyNames": { "$ref": "#/$defs/safePath" },
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "engram_source_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "discovery_policy",
        "git",
        "source_roster_sha256",
        "host_modules",
        "worker_project_modules",
        "worker_project_source_roster_sha256",
        "reviewed_runtime_handshake_receipt_sha256",
        "reviewed_runtime_guardian_source_sha256",
        "reviewed_runtime_exec_gate_source_sha256",
        "reviewed_runtime_exec_gate_command_sha256",
        "exercised_entrypoints",
        "sources",
        "closure_sha256"
      ],
      "properties": {
        "schema_version": { "const": "crebain.engram-python-source-closure.v1" },
        "discovery_policy": {
          "const": "loaded-host-modules-plus-worker-runtime-identity-and-entrypoints.v1"
        },
        "git": { "$ref": "#/$defs/gitIdentity" },
        "source_roster_sha256": { "$ref": "#/$defs/sha256" },
        "host_modules": { "$ref": "#/$defs/moduleRoster" },
        "worker_project_modules": { "$ref": "#/$defs/moduleRoster" },
        "worker_project_source_roster_sha256": { "$ref": "#/$defs/sha256" },
        "reviewed_runtime_handshake_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "reviewed_runtime_guardian_source_sha256": { "$ref": "#/$defs/sha256" },
        "reviewed_runtime_exec_gate_source_sha256": { "$ref": "#/$defs/sha256" },
        "reviewed_runtime_exec_gate_command_sha256": { "$ref": "#/$defs/sha256" },
        "exercised_entrypoints": {
          "const": [
            {
              "relative_path": "backend/optimization/extension_closed_loop_nest_guardian.py",
              "role": "nest-guardian"
            },
            {
              "relative_path": "backend/optimization/extension_closed_loop_nest_worker.py",
              "role": "nest-worker"
            },
            {
              "relative_path": "backend/integrations/reviewed_native_process_guardian.py",
              "role": "reviewed-runtime-guardian"
            }
          ]
        },
        "sources": { "$ref": "#/$defs/sourceRoster" },
        "closure_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "package_generation_id": {
      "type": "string",
      "pattern": "^pkggen_[a-f0-9]{64}$"
    },
    "installed_package_proof_exact_sha256": { "$ref": "#/$defs/sha256" },
    "installed_package_proof": {
      "$ref": "https://crebain.local/schemas/crebain.standard-v3-installed-binary-proof.v3.schema.json"
    },
    "plan_exact_sha256": { "$ref": "#/$defs/sha256" },
    "nest_config_exact_sha256": { "$ref": "#/$defs/sha256" },
    "receipt_lock_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "run_plan": { "type": "object", "minProperties": 1 },
    "nest_config": { "type": "object", "minProperties": 1 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "calibrated_posterior",
        "channel_count",
        "completed_step_count",
        "evidence_bundle_sha256",
        "ncp_qualified",
        "physical_actuation",
        "planned_step_count",
        "receipt_sha256",
        "reservation_id",
        "run_status",
        "scientific_authority",
        "simulator_only",
        "status",
        "store_id",
        "study_run_id",
        "terminal_reason_code"
      ],
      "properties": {
        "authority": { "const": false },
        "calibrated_posterior": { "const": false },
        "channel_count": { "type": "integer", "minimum": 1, "maximum": 3 },
        "completed_step_count": { "const": 6 },
        "evidence_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "ncp_qualified": { "const": false },
        "physical_actuation": { "const": false },
        "planned_step_count": { "const": 6 },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "reservation_id": {
          "type": "string",
          "pattern": "^clrr_[a-f0-9]{64}$"
        },
        "run_status": { "const": "completed" },
        "scientific_authority": { "const": false },
        "simulator_only": { "const": true },
        "status": { "const": "recorded" },
        "store_id": { "type": "string", "pattern": "^clrs_[a-f0-9]{64}$" },
        "study_run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "terminal_reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "terminal_receipt": {
      "$ref": "https://engram.local/schemas/engram.extension-closed-loop-run-receipt.v2.schema.json"
    },
    "reviewed_native_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handshake_receipt",
        "termination_receipt",
        "exec_gate_command_binding",
        "lifecycle_binding_sha256",
        "guardian_closure_verified",
        "package_store_lineage_verified"
      ],
      "properties": {
        "handshake_receipt": {
          "$ref": "https://engram.local/schemas/engram.reviewed-native-development-handshake.v1.schema.json"
        },
        "termination_receipt": {
          "$ref": "https://engram.local/schemas/engram.reviewed-native-development-termination.v1.schema.json"
        },
        "exec_gate_command_binding": {
          "$ref": "https://engram.local/schemas/engram.contained-exec-command.v1.schema.json"
        },
        "lifecycle_binding_sha256": { "$ref": "#/$defs/sha256" },
        "guardian_closure_verified": { "const": true },
        "package_store_lineage_verified": { "const": true }
      }
    },
    "nest_worker_guardian_closure": { "type": "object", "minProperties": 1 },
    "receipt_store_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "store_id",
        "receipt_sha256",
        "receipt_artifact_path",
        "evidence_bundle_sha256",
        "evidence_artifact_path",
        "file_count",
        "total_bytes",
        "files",
        "closure_sha256"
      ],
      "properties": {
        "schema_version": { "const": "crebain.closed-loop-receipt-store-closure.v1" },
        "store_id": { "type": "string", "pattern": "^clrs_[a-f0-9]{64}$" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "receipt_artifact_path": {
          "type": "string",
          "pattern": "^receipts/[a-f0-9]{2}/[a-f0-9]{64}\\.json$"
        },
        "evidence_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_artifact_path": {
          "type": "string",
          "pattern": "^evidence/[a-f0-9]{2}/[a-f0-9]{64}\\.json$"
        },
        "file_count": { "const": 8 },
        "total_bytes": { "type": "integer", "minimum": 1, "maximum": 134217728 },
        "files": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relative_path", "size_bytes", "sha256"],
            "properties": {
              "relative_path": { "$ref": "#/$defs/safePath" },
              "size_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777216
              },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["relative_path"],
                "properties": { "relative_path": { "const": "store.json" } }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["relative_path"],
                "properties": { "relative_path": { "const": "writer.lock" } }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "closure_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "receipt_store_sidecars": { "$ref": "#/$defs/receiptStoreSidecars" },
    "population_topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_count",
        "drone_count",
        "action_axis_count",
        "population_count",
        "population_neuron_count",
        "device_node_count",
        "connection_count",
        "population_names",
        "derived_population_roster_sha256"
      ],
      "properties": {
        "session_count": { "const": 1 },
        "drone_count": { "type": "integer", "minimum": 1, "maximum": 3 },
        "action_axis_count": { "type": "integer", "minimum": 3, "maximum": 9 },
        "population_count": { "type": "integer", "minimum": 6, "maximum": 18 },
        "population_neuron_count": { "type": "integer", "minimum": 1 },
        "device_node_count": { "type": "integer", "minimum": 12, "maximum": 36 },
        "connection_count": { "type": "integer", "minimum": 1 },
        "population_names": {
          "type": "array",
          "minItems": 6,
          "maxItems": 18,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "derived_population_roster_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nest_evidence_bundle": {
      "$ref": "https://engram.local/schemas/engram.nest-closed-loop-evidence-bundle.v2.schema.json"
    },
    "neural_steps": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/neuralStep" }
    },
    "assertions": {
      "const": {
        "fault_then_next_step_hold": true,
        "nest_hold_washout_and_reset_verified": true,
        "nest_recovery_washout_and_reset_verified": true,
        "resumed_nest_proposal_nonzero": true,
        "other_channels_never_entered_safety_mode": true,
        "terminal_receipt_and_neural_result_lineage_verified": true,
        "engram_host_and_worker_source_closure_verified": true,
        "reviewed_runtime_guardian_lineage_verified": true,
        "engram_commit_equals_local_origin_main": true,
        "private_frozen_run_inputs_used": true,
        "one_nest_session_exact_6n_population_topology_verified": true,
        "nest_worker_guardian_terminal_closure_verified": true,
        "receipt_store_artifact_closure_verified": true,
        "installed_generation_seal_package_bundle_store_lineage_verified": true
      }
    },
    "authority": { "$ref": "#/$defs/simulatorAuthority" },
    "disclosure": { "type": "string", "minLength": 1, "maxLength": 4096 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "entityId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "stepId": { "type": "string", "pattern": "^step_[a-f0-9]{32}$" },
    "finiteNumber": {
      "type": "number",
      "minimum": -1e300,
      "maximum": 1e300
    },
    "neuralStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "result"],
      "properties": {
        "request": { "$ref": "#/$defs/neuralStepRequest" },
        "result": { "$ref": "#/$defs/neuralStepResult" }
      }
    },
    "neuralInputChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_id", "subject_id", "observation_values", "hold_required", "fault_code"],
      "properties": {
        "channel_id": { "$ref": "#/$defs/entityId" },
        "subject_id": { "$ref": "#/$defs/entityId" },
        "observation_values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/finiteNumber" }
        },
        "hold_required": { "type": "boolean" },
        "fault_code": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "neuralStepRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "study_run_id",
        "step_index",
        "step_id",
        "neural_preparation_sha256",
        "source_snapshot_sha256",
        "observation_runtime_time_tics",
        "runtime_interval_end_time_tics",
        "runtime_interval_tics",
        "controller_start_time_tics",
        "controller_end_time_tics",
        "controller_interval_tics",
        "channels",
        "request_sha256"
      ],
      "properties": {
        "schema_version": { "const": "engram.closed-loop-neural-step-request.v1" },
        "study_run_id": { "$ref": "#/$defs/entityId" },
        "step_index": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "step_id": { "$ref": "#/$defs/stepId" },
        "neural_preparation_sha256": { "$ref": "#/$defs/sha256" },
        "source_snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "observation_runtime_time_tics": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10240000000
        },
        "runtime_interval_end_time_tics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10240000000
        },
        "runtime_interval_tics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "controller_start_time_tics": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10240000000
        },
        "controller_end_time_tics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10240000000
        },
        "controller_interval_tics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/neuralInputChannel" }
        },
        "request_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "neuralActionProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_id", "values", "source_populations"],
      "properties": {
        "channel_id": { "$ref": "#/$defs/entityId" },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/finiteNumber" }
        },
        "source_populations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/entityId" }
        }
      }
    },
    "neuralStepResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "study_run_id",
        "step_index",
        "step_id",
        "request_sha256",
        "provider_execution_scope",
        "provider_execution_sha256",
        "controller_start_time_tics",
        "controller_end_time_tics",
        "proposals",
        "result_sha256"
      ],
      "properties": {
        "schema_version": { "const": "engram.closed-loop-neural-step-result.v1" },
        "study_run_id": { "$ref": "#/$defs/entityId" },
        "step_index": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "step_id": { "$ref": "#/$defs/stepId" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "provider_execution_scope": {
          "enum": ["decoded-proposal-only", "nest-exact-step-readback"]
        },
        "provider_execution_sha256": { "$ref": "#/$defs/sha256" },
        "controller_start_time_tics": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10240000000
        },
        "controller_end_time_tics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10240000000
        },
        "proposals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/neuralActionProposal" }
        },
        "result_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "gitObject": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+$"
    },
    "pythonPath": {
      "allOf": [{ "$ref": "#/$defs/safePath" }, { "pattern": "\\.py$" }]
    },
    "gitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree", "origin_main", "object_format", "clean"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "commit": { "$ref": "#/$defs/gitObject" },
        "tree": { "$ref": "#/$defs/gitObject" },
        "origin_main": { "$ref": "#/$defs/gitObject" },
        "object_format": { "enum": ["sha1", "sha256"] },
        "clean": { "const": true }
      },
      "allOf": [{ "$ref": "#/$defs/gitObjectFormatJoin" }]
    },
    "gitObjectFormatJoin": {
      "if": {
        "properties": { "object_format": { "const": "sha1" } },
        "required": ["object_format"]
      },
      "then": {
        "properties": {
          "commit": { "pattern": "^[a-f0-9]{40}$" },
          "tree": { "pattern": "^[a-f0-9]{40}$" },
          "origin_main": { "pattern": "^[a-f0-9]{40}$" }
        }
      },
      "else": {
        "properties": {
          "commit": { "pattern": "^[a-f0-9]{64}$" },
          "tree": { "pattern": "^[a-f0-9]{64}$" },
          "origin_main": { "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "moduleRoster": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module_name", "relative_path"],
        "properties": {
          "module_name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          },
          "relative_path": { "$ref": "#/$defs/pythonPath" }
        }
      }
    },
    "sourceRoster": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "size_bytes", "sha256", "git_mode", "git_blob"],
        "properties": {
          "relative_path": { "$ref": "#/$defs/pythonPath" },
          "size_bytes": { "type": "integer", "minimum": 0, "maximum": 16777216 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "git_mode": { "enum": ["100644", "100755"] },
          "git_blob": { "$ref": "#/$defs/gitObject" }
        }
      }
    },
    "receiptStoreSidecars": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "store_metadata",
        "finalized_reservation",
        "observation",
        "publication_admission_anchor",
        "publication_authority",
        "closure_sha256"
      ],
      "properties": {
        "schema_version": { "const": "crebain.closed-loop-receipt-store-sidecars.v1" },
        "store_metadata": { "$ref": "#/$defs/storeMetadata" },
        "finalized_reservation": { "$ref": "#/$defs/finalizedReservation" },
        "observation": { "$ref": "#/$defs/storedObservation" },
        "publication_admission_anchor": { "$ref": "#/$defs/publicationAnchor" },
        "publication_authority": { "$ref": "#/$defs/publicationAuthority" },
        "closure_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "storeMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "store_id",
        "policy",
        "digest_canonicalization",
        "execution_authority",
        "ncp_control",
        "physical_actuation",
        "scientific_authority",
        "is_paper_local_evidence",
        "calibrated_posterior"
      ],
      "properties": {
        "schema_version": { "const": "engram.extension-closed-loop-receipt-store.v5" },
        "store_id": { "type": "string", "pattern": "^clrs_[a-f0-9]{64}$" },
        "policy": { "const": "engram.extension-closed-loop-receipt-store-policy.v5" },
        "digest_canonicalization": { "const": "engram.managed-runtime-json.v1" },
        "execution_authority": { "const": false },
        "ncp_control": { "const": false },
        "physical_actuation": { "const": false },
        "scientific_authority": { "const": false },
        "is_paper_local_evidence": { "const": false },
        "calibrated_posterior": { "const": false }
      }
    },
    "finalizedReservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "store_id",
        "reservation",
        "pre_spawn_sha256",
        "extension_dispatch_sha256",
        "simulation_dispatch_sha256",
        "terminal_receipt_sha256",
        "evidence_bundle_sha256",
        "nest_work_admission_rejoined",
        "execution_authority",
        "ncp_control",
        "physical_actuation",
        "scientific_authority",
        "is_paper_local_evidence",
        "calibrated_posterior",
        "finalization_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "engram.extension-closed-loop-finalized-reservation.v1"
        },
        "store_id": { "type": "string", "pattern": "^clrs_[a-f0-9]{64}$" },
        "reservation": { "$ref": "#/$defs/receiptReservation" },
        "pre_spawn_sha256": { "$ref": "#/$defs/sha256" },
        "extension_dispatch_sha256": { "$ref": "#/$defs/sha256" },
        "simulation_dispatch_sha256": { "$ref": "#/$defs/sha256" },
        "terminal_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_bundle_sha256": { "$ref": "#/$defs/sha256" },
