{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engram.local/schemas/engram.closed-loop-simulator.prepare-request.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_run_id",
    "closed_loop_definition_sha256",
    "runtime_adapter_configuration_sha256",
    "step_count",
    "tic_unit",
    "causality_policy",
    "step_duration_tics",
    "channel_ids",
    "subject_kinds",
    "subject_ids",
    "observation_space_ids",
    "action_space_ids",
    "observation_widths",
    "action_widths",
    "action_min_values",
    "action_max_values",
    "safe_action_values"
  ],
  "properties": {
    "schema_version": {"const": "engram.closed-loop-simulator.prepare-request.v2"},
    "study_run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "closed_loop_definition_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "runtime_adapter_configuration_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "step_count": {"type": "integer", "minimum": 1, "maximum": 1024},
    "tic_unit": {"const": "microsecond"},
    "causality_policy": {"const": "sample-runtime-run-controller-apply-zoh-v1"},
    "step_duration_tics": {"type": "integer", "minimum": 1, "maximum": 10000000},
    "channel_ids": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "subject_kinds": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 3, "maxLength": 128}},
    "subject_ids": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "observation_space_ids": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 3, "maxLength": 128}},
    "action_space_ids": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 3, "maxLength": 128}},
    "observation_widths": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "integer", "minimum": 1, "maximum": 16}},
    "action_widths": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "integer", "minimum": 1, "maximum": 16}},
    "action_min_values": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "number"}},
    "action_max_values": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "number"}},
    "safe_action_values": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "number"}}
  }
}
