{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engram.local/schemas/crebain.managed-simulation.step-request.v1.schema.json",
  "title": "CREBAIN simulation step request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "tick_index",
    "drone_ids",
    "actuator_intent_acceleration_mps2",
    "sensor_offset_m",
    "fault_codes"
  ],
  "properties": {
    "schema_version": { "const": "crebain.simulation.step-request.v1" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "tick_index": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "drone_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "actuator_intent_acceleration_mps2": {
      "type": "array",
      "minItems": 3,
      "maxItems": 9,
      "items": { "type": "number", "minimum": -50, "maximum": 50 }
    },
    "sensor_offset_m": {
      "type": "array",
      "minItems": 3,
      "maxItems": 9,
      "items": { "type": "number", "minimum": -50, "maximum": 50 }
    },
    "fault_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "enum": [
          "none",
          "sensor-dropout",
          "actuator-hold",
          "combined",
          "overload"
        ]
      }
    }
  }
}
