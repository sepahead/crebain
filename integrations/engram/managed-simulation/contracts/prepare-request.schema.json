{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engram.local/schemas/crebain.managed-simulation.prepare-request.v1.schema.json",
  "title": "CREBAIN simulation prepare request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "drone_ids",
    "tick_ms",
    "max_ticks",
    "initial_position_m",
    "initial_velocity_mps",
    "sensor_variance_m2"
  ],
  "properties": {
    "schema_version": { "const": "crebain.simulation.prepare-request.v1" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "drone_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "tick_ms": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "max_ticks": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "initial_position_m": {
      "type": "array",
      "minItems": 3,
      "maxItems": 9,
      "items": { "type": "number", "minimum": -100000, "maximum": 100000 }
    },
    "initial_velocity_mps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 9,
      "items": { "type": "number", "minimum": -100, "maximum": 100 }
    },
    "sensor_variance_m2": {
      "type": "array",
      "minItems": 3,
      "maxItems": 9,
      "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 }
    }
  }
}
