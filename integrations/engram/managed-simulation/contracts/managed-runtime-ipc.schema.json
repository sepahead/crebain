{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engram.local/schemas/engram.managed-runtime-ipc.v1.schema.json",
  "title": "Engram managed runtime inherited-pipe IPC v1",
  "$comment": "The uint32-be frame length is external to this JSON payload and remains host-observed metadata. This schema has no lifecycle, readiness, cancellation, shutdown, exit, artifact-read, or artifact-write message path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "kind",
    "sender",
    "generation",
    "sequence",
    "message_id",
    "body"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "protocol": { "const": "engram.managed-runtime-ipc.v1" },
    "kind": {
      "enum": [
        "host.handshake",
        "runtime.handshake",
        "operation.request",
        "operation.response"
      ]
    },
    "sender": { "enum": ["host", "runtime"] },
    "generation": { "$ref": "#/$defs/generation" },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "message_id": {
      "type": "string",
      "pattern": "^msg_[a-f0-9]{32}$"
    },
    "body": {}
  },
  "oneOf": [
    {
      "properties": {
        "kind": { "const": "host.handshake" },
        "sender": { "const": "host" },
        "sequence": { "const": 0 },
        "body": { "$ref": "#/$defs/hostHandshake" }
      }
    },
    {
      "properties": {
        "kind": { "const": "runtime.handshake" },
        "sender": { "const": "runtime" },
        "sequence": { "const": 0 },
        "body": { "$ref": "#/$defs/runtimeHandshake" }
      }
    },
    {
      "properties": {
        "kind": { "const": "operation.request" },
        "sender": { "const": "host" },
        "sequence": { "type": "integer", "minimum": 1 },
        "body": { "$ref": "#/$defs/operationRequest" }
      }
    },
    {
      "properties": {
        "kind": { "const": "operation.response" },
        "sender": { "const": "runtime" },
        "sequence": { "type": "integer", "minimum": 1 },
        "body": { "$ref": "#/$defs/operationResponse" }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "componentIdentifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
      "maxLength": 128
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installation_id", "generation_id", "ordinal"],
      "properties": {
        "installation_id": {
          "type": "string",
          "pattern": "^inst_[a-f0-9]{64}$"
        },
        "generation_id": {
          "type": "string",
          "pattern": "^gen_[a-f0-9]{64}$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "contentBoundSchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_sha256"],
      "properties": {
        "schema_id": { "$ref": "#/$defs/componentIdentifier" },
        "schema_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "identityEcho": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_exact_sha256",
        "manifest_canonical_sha256",
        "package_lock_exact_sha256",
        "package_lock_canonical_sha256",
        "package_sha256",
        "executable_sha256",
        "configuration_exact_sha256",
        "configuration_canonical_sha256",
        "target_id",
        "profile",
        "launch_abi",
        "operation_roster_sha256",
        "schema_registry_sha256",
        "installation_id"
      ],
      "properties": {
        "manifest_exact_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_canonical_sha256": { "$ref": "#/$defs/sha256" },
        "package_lock_exact_sha256": { "$ref": "#/$defs/sha256" },
        "package_lock_canonical_sha256": { "$ref": "#/$defs/sha256" },
        "package_sha256": { "$ref": "#/$defs/sha256" },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "configuration_exact_sha256": { "$ref": "#/$defs/sha256" },
        "configuration_canonical_sha256": { "$ref": "#/$defs/sha256" },
        "target_id": { "$ref": "#/$defs/componentIdentifier" },
        "profile": { "$ref": "#/$defs/componentIdentifier" },
        "launch_abi": { "const": "engram.managed-runtime-stdio.v1" },
        "operation_roster_sha256": { "$ref": "#/$defs/sha256" },
        "schema_registry_sha256": { "$ref": "#/$defs/sha256" },
        "installation_id": {
          "type": "string",
          "pattern": "^inst_[a-f0-9]{64}$"
        }
      }
    },
    "hostHandshake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challenge", "identity", "configuration", "max_frame_bytes"],
      "properties": {
        "challenge": {
          "type": "string",
          "pattern": "^chal_[a-f0-9]{64}$"
        },
        "identity": { "$ref": "#/$defs/identityEcho" },
        "configuration": { "$ref": "#/$defs/handshakeConfiguration" },
        "max_frame_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        }
      }
    },
    "handshakeConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "canonical_sha256", "document"],
      "properties": {
        "schema": { "$ref": "#/$defs/contentBoundSchemaRef" },
        "canonical_sha256": { "$ref": "#/$defs/sha256" },
        "document": {}
      }
    },
    "runtimeHandshake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_challenge", "runtime_nonce", "identity", "ready_claim"],
      "properties": {
        "host_challenge": {
          "type": "string",
          "pattern": "^chal_[a-f0-9]{64}$"
        },
        "runtime_nonce": {
          "type": "string",
          "pattern": "^nonce_[a-f0-9]{64}$"
        },
        "identity": { "$ref": "#/$defs/identityEcho" },
        "ready_claim": { "const": false }
      }
    },
    "controlScalar": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        {
          "type": "number",
          "minimum": -1e300,
          "maximum": 1e300,
          "not": { "type": "integer" }
        },
        { "type": "string", "maxLength": 1024 }
      ]
    },
    "controlValue": {
      "oneOf": [
        { "$ref": "#/$defs/controlScalar" },
        {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/controlScalar" }
        }
      ]
    },
    "controlObject": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/controlValue" }
    },
    "bulkNone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inline", "references"],
      "properties": {
        "inline": { "const": false },
        "references": { "type": "array", "maxItems": 0 }
      }
    },
    "operationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "class", "effect", "artifact_access"],
      "properties": {
        "operation_id": { "$ref": "#/$defs/componentIdentifier" },
        "class": {
          "enum": ["observation", "offline-analysis", "simulation"]
        },
        "effect": { "const": "none" },
        "artifact_access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "write"],
          "properties": {
            "read": { "const": "none" },
            "write": { "const": "none" }
          }
        }
      }
    },
    "computeGrant": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "grant_id",
            "generation_id",
            "operation_id",
            "issued_for_sequence",
            "max_cpu_time_ms",
            "valid_for_ms",
            "reusable"
          ],
          "properties": {
            "mode": { "const": "host-one-shot" },
            "grant_id": {
              "type": "string",
              "pattern": "^grant_[a-f0-9]{64}$"
            },
            "generation_id": {
              "type": "string",
              "pattern": "^gen_[a-f0-9]{64}$"
            },
            "operation_id": { "$ref": "#/$defs/componentIdentifier" },
            "issued_for_sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "max_cpu_time_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            "valid_for_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600000
            },
            "reusable": { "const": false }
          }
        }
      ]
    },
    "operationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotency_key",
        "operation",
        "request_schema",
        "response_schema",
        "compute_grant",
        "timeout_ms",
        "control",
        "bulk"
      ],
      "properties": {
        "idempotency_key": {
          "type": "string",
          "pattern": "^idem_[a-f0-9]{64}$"
        },
        "operation": { "$ref": "#/$defs/operationIdentity" },
        "request_schema": { "$ref": "#/$defs/contentBoundSchemaRef" },
        "response_schema": { "$ref": "#/$defs/contentBoundSchemaRef" },
        "compute_grant": { "$ref": "#/$defs/computeGrant" },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 600000 },
        "control": { "$ref": "#/$defs/controlObject" },
        "bulk": { "$ref": "#/$defs/bulkNone" }
      }
    },
    "operationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_message_id",
        "idempotency_key",
        "operation",
        "response_schema",
        "status",
        "control",
        "bulk"
      ],
      "properties": {
        "request_message_id": {
          "type": "string",
          "pattern": "^msg_[a-f0-9]{32}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^idem_[a-f0-9]{64}$"
        },
        "operation": { "$ref": "#/$defs/operationIdentity" },
        "response_schema": { "$ref": "#/$defs/contentBoundSchemaRef" },
        "status": {
          "enum": ["succeeded", "rejected", "failed", "cancelled"]
        },
        "control": { "$ref": "#/$defs/controlObject" },
        "bulk": { "$ref": "#/$defs/bulkNone" }
      }
    }
  }
}
