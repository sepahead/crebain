{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engram.local/schemas/engram.closed-loop-simulator.step-request.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_run_id",
    "step_index",
    "step_id",
    "source_snapshot_sha256",
    "runtime_request_sha256",
    "tic_unit",
    "causality_policy",
    "step_duration_tics",
    "source_simulation_time_tics",
    "target_simulation_time_tics",
    "channel_ids",
    "subject_ids",
    "action_widths",
    "action_values",
    "saturated_values",
    "action_dispositions"
  ],
  "properties": {
    "schema_version": {"const": "engram.closed-loop-simulator.step-request.v2"},
    "study_run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "step_index": {"type": "integer", "minimum": 1, "maximum": 1024},
    "step_id": {"type": "string", "minLength": 37, "maxLength": 37},
    "source_snapshot_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "runtime_request_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "tic_unit": {"const": "microsecond"},
    "causality_policy": {"const": "sample-runtime-run-controller-apply-zoh-v1"},
    "step_duration_tics": {"type": "integer", "minimum": 1, "maximum": 10000000},
    "source_simulation_time_tics": {"type": "integer", "minimum": 0, "maximum": 10240000000},
    "target_simulation_time_tics": {"type": "integer", "minimum": 1, "maximum": 10240000000},
    "channel_ids": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "subject_ids": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "action_widths": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "integer", "minimum": 1, "maximum": 16}},
    "action_values": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "number"}},
    "saturated_values": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "boolean"}},
    "action_dispositions": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"enum": ["bounded-neural-proposal", "safe-hold"]}}
  }
}
