{
  "schema": "crebain.sensor-pressure.v1",
  "tensor": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "kind",
      "dtype",
      "shape",
      "layout",
      "sample_start",
      "sample_end",
      "sample_rate_hz",
      "unit"
    ],
    "properties": {
      "kind": {
        "const": "pressure"
      },
      "dtype": {
        "const": "f64le"
      },
      "shape": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1,
        "items": {
          "type": "integer",
          "minimum": 133,
          "maximum": 134
        }
      },
      "layout": {
        "const": "c_contiguous"
      },
      "sample_start": {
        "type": "integer",
        "minimum": 0,
        "maximum": 960000
      },
      "sample_end": {
        "type": "integer",
        "minimum": 1,
        "maximum": 960000
      },
      "sample_rate_hz": {
        "const": 16000
      },
      "unit": {
        "const": "pascal"
      }
    }
  },
  "time": "source_body_tick=available_after_body_tick=k; t=k/120 seconds",
  "raw_bit_preservation": true,
  "floating_point_policy": "finite; signed zero preserved",
  "meaning": "actual source discrete acoustic float64-le samples in pascals"
}
